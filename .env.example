POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_ai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/document_ai
# LLM_PROVIDER=openai usa OpenAI; LLM_PROVIDER=ollama usa un modelo local de Ollama
# (requiere Ollama corriendo en el host; desde el contenedor backend se accede
# via host.docker.internal, no localhost).
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=/api
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=200000
MAX_PDF_PAGES=200
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.25
AI_TIMEOUT_SECONDS=45
