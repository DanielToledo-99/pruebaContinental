POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=document_ai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/document_ai
# LLM_PROVIDER=openai usa OpenAI; LLM_PROVIDER=ollama usa un modelo local de Ollama
# (requiere Ollama >= 0.5 corriendo en el host; desde el contenedor backend se
# accede via host.docker.internal, no localhost. En Linux, Ollama debe escuchar
# en todas las interfaces: OLLAMA_HOST=0.0.0.0 ollama serve).
LLM_PROVIDER=openai
# Proveedor de embeddings: openai u ollama. Si no se define, usa LLM_PROVIDER,
# de modo que LLM_PROVIDER=ollama funciona sin OPENAI_API_KEY.
# EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Modelo multilingüe de embeddings: ollama pull bge-m3
OLLAMA_EMBEDDING_MODEL=bge-m3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=/api
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=200000
MAX_PDF_PAGES=200
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.25
# Con Ollama en CPU conviene subirlo (máximo 120): la primera carga del modelo es lenta.
AI_TIMEOUT_SECONDS=45
